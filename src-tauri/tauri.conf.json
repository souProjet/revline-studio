{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revline Studio",
  "version": "0.1.0",
  "identifier": "studio.revline.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Revline Studio",
        "width": 1680,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["/media/**", "/run/media/**", "/mnt/**", "/Volumes/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
